# ===== NZDPU API =====
# 注册地址: https://www.nzdpu.com/ 注册后免费获取 token
NZDPU_API_TOKEN=

# ===== LLM (OpenAI 兼容协议) =====
# 任意兼容 OpenAI Chat Completions 的服务：OpenAI / DeepSeek / Ollama / vLLM / Azure 等
# DeepSeek 示例: base=https://api.deepseek.com, model=deepseek-chat
# 本地 Ollama 示例: base=http://localhost:11434/v1, model=qwen2.5:7b, key=ollama
# OpenAI 官方: base=https://api.openai.com/v1, model=gpt-4o-mini
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ===== 路径 =====
CACHE_DIR=./data/cache
HKEX_DOWNLOAD_DIR=./data/hkex_reports

# ===== 留资线索 =====
# 查看留资页 /admin/leads?token=xxx 的口令；不设置则该页直接 403
ADMIN_TOKEN=
# 收到留资时推送到该 webhook（飞书/钉钉/企业微信群机器人、n8n、Zapier 均可）
# 云平台 /tmp 会随重新部署清空，webhook 是线索不丢的可靠方式
LEAD_WEBHOOK_URL=

# ===== 留资自动接待 =====
# Gmail 需先开两步验证，再生成「应用专用密码」填 SMTP_PASS
# 配置后：客户提交即收到自动回信（附模板链接），同时给你发一封通知
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=webmarinda@gmail.com

# ===== 统计 =====
# Google tag：GTM 容器 ID（GTM-XXXXXXX）与 GA4 衡量 ID（G-XXXXXXXXXX）二选一或都填
GTM_ID=GTM-PW52WWDX
GA4_ID=

# ===== 采集表付费下载（微信支付 V2 · Native 扫码）=====
# 商户平台 → 产品中心开通「Native 支付」，并在 AppID 账号管理里绑定商户号
WX_APPID=
WX_MCHID=
WX_API_V2_KEY=
WX_SIGN_TYPE=MD5
# 微信回调域名：必须是公网 HTTPS 且指向本服务（默认主站）
PAY_PUBLIC_BASE_URL=https://esg-v1-0uyh.onrender.com
# 授权码签名密钥，建议 32 位随机字符串；留空时回落到 WX_API_V2_KEY
LICENSE_SECRET=
# 手动授权码（线下转账 / 老用户过渡 / 企业批量授权），逗号、分号或空格分隔
TEMPLATE_LICENSE_CODES=
# 按商品作用域的手动码：report:CODE1,polish:CODE2,template:CODE3（三种码互不通用）
SCOPED_LICENSE_CODES=

# ===== 订单台账（长期留存与对账）=====
# 推荐免费 Neon / Supabase Postgres，直接填连接串：
#   postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
# 配置后 Render 重新部署不会丢失订单；未配置时回落到本地 SQLite（仅本地/演示）。
ORDER_DATABASE_URL=
# 可选：SQLite 路径（默认 v2/data/orders.db）；Render 免费层会随部署清空
ORDER_DB_PATH=
# 管理页：/api/pay/admin/ledger/view?token=<ADMIN_TOKEN>

# ===== HTTP =====
# HKEX 抓取必须带真实可联系 UA
USER_AGENT=ESG-Report-Bot/0.1 contact@example.com

# ===== 端点（一般无需改） =====
NZDPU_BASE_URL=https://api.nzdpu.com/v1
DATA_GOV_HK_BASE_URL=https://app.data.gov.hk/v1
# SBTi 公开数据（无需 token，免费）— 官方每周更新的公司目标 Excel 清单
SBTI_BASE_URL=https://files.sciencebasedtargets.org/production/files/companies-excel.xlsx
# 新浪财经 ESG 评级中心（免费无 token，多机构 ESG 评级，替代 CDP）
# 覆盖 MSCI/标普/中证指数/国证/商道融绿/华证/秩鼎/妙盈等多家机构
SINA_ESG_BASE_URL=https://global.finance.sina.com.cn/api/openapi.php
# World Bank Open Data（免费无 token，国家级排放基准）
WORLDBANK_BASE_URL=https://api.worldbank.org/v2
