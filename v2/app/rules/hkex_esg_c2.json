  "coverage_note": "B 部分与 C 部分已按官方条文逐项录入；D 部分当前仅收录已核对段落（17、19、20），其余段落待补。全部规则状态为 draft，正式对外交付前须经专业复核。",
  "rules": [
    {
      "id": "B-13",
      "part": "B",
      "paragraph": "13",
      "title": "董事会声明",
      "requirement": "由董事会发出声明，载明董事会对 ESG 事宜的监管、ESG 管理方针及策略（含评估及优次排列重要议题的过程），以及董事会如何按 ESG 目标检讨进度并解释其与业务的关系。",
      "applicability": [
        {"issuer_type": "main_board", "fy_from": null, "obligation": "mandatory"},
        {"issuer_type": "gem", "fy_from": null, "obligation": "mandatory"}
      ],
      "required_fields": ["board_statement", "board_oversight", "esg_strategy_process", "target_review"],
      "evidence": ["董事会决议", "ESG 报告正文"]
    },
    {
      "id": "B-14",
      "part": "B",
      "paragraph": "14",
      "title": "汇报原则（重要性／量化／一致性）",
      "requirement": "描述编制报告时如何应用重要性、量化及一致性原则：识别重要因素的过程与准则、持份者参与过程与结果、排放与能耗的计算方法及转换因素来源、统计方法或 KPI 变更的说明。",
      "applicability": [
        {"issuer_type": "main_board", "fy_from": null, "obligation": "mandatory"},
        {"issuer_type": "gem", "fy_from": null, "obligation": "mandatory"}
      ],
      "required_fields": ["materiality_process", "stakeholder_engagement", "quantification_method", "emission_factor_source", "consistency_statement"],
      "evidence": ["制度文件", "方法说明"]
    },
    {
      "id": "B-15",
      "part": "B",
      "paragraph": "15",
      "title": "汇报范围",
      "requirement": "解释报告范围及挑选纳入实体或业务的过程；若汇报范围有所改变，说明不同之处及变动原因。",
      "applicability": [
        {"issuer_type": "main_board", "fy_from": null, "obligation": "mandatory"},
        {"issuer_type": "gem", "fy_from": null, "obligation": "mandatory"}
      ],
      "required_fields": ["boundary", "boundary_entities", "boundary_change_note"],
      "evidence": ["组织架构文件", "ESG 报告正文"]
    },
    {
